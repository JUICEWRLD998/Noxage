{
  "name": "@noxage/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Noxage smart contracts — Hardhat + iExec Nox",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:sepolia": "hardhat run scripts/deploy-confidential.ts --network sepolia",
    "deploy:intents:sepolia": "hardhat run scripts/deploy-intents.ts --network sepolia",
    "deploy:settlement:sepolia": "hardhat run scripts/deploy-settlement.ts --network sepolia",
    "ops:open-epoch:sepolia": "hardhat run scripts/open-epoch.ts --network sepolia",
    "ops:finalize:sepolia": "hardhat run scripts/finalize-settlement.ts --network sepolia",
    "preflight:sepolia": "hardhat run scripts/preflight-noxage.ts --network sepolia",
    "check": "tsc --noEmit",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20",
    "dotenv": "^16.6.1",
    "encrypted-types": "0.0.4",
    "hardhat": "^2.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "@openzeppelin/confidential-contracts": "0.5.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
